# /etc/tomtube/tomtube.env (owner tom, mode 600). See docs/TOMTUBE.md for every setting.

# Required: the bearer token the Worker sends (TOMTUBE_SERVICE_TOKEN there). At least 32 characters:
#   openssl rand -base64 48
TOMTUBE_TOKEN=

# Where it listens. Keep it on loopback; the Cloudflare Tunnel reaches it there.
TOMTUBE_HOST=127.0.0.1
TOMTUBE_PORT=8790

# State (yt-dlp's player cache) and the audio cache. The systemd unit creates both.
TOMTUBE_STATE_DIR=/var/lib/tomtube
TOMTUBE_CACHE_DIR=/var/cache/tomtube/audio

# yt-dlp: keep it current (`yt-dlp -U`, or the tomtube-ytdlp-update timer). YouTube needs a JavaScript
# runtime for its player challenges; Deno is yt-dlp's default and recommended one.
TOMTUBE_YTDLP_PATH=/opt/tomtube/bin/yt-dlp
TOMTUBE_YTDLP_JS_RUNTIME=deno:/usr/local/bin/deno
# Only needed when yt-dlp was installed with pip rather than as the official binary:
# TOMTUBE_YTDLP_REMOTE_COMPONENTS=ejs:github
# Leave unset to use yt-dlp's own default clients. Set only when the docs or yt-dlp's issues say so.
# TOMTUBE_YTDLP_PLAYER_CLIENTS=default
# Optional: a Proof-of-Origin token provider (bgutil-ytdlp-pot-provider, docker-compose.pot-provider.yml).
# The yt-dlp plugin must be installed too (docs/TOMTUBE.md).
# TOMTUBE_POT_PROVIDER_URL=http://127.0.0.1:4416
# Optional: a Netscape cookie file from a throwaway YouTube account, for age-restricted videos or when
# YouTube keeps asking the server to sign in. Never commit it; keep it under /opt/tomtube/secrets.
# TOMTUBE_YOUTUBE_COOKIES=/opt/tomtube/secrets/youtube.cookies

# Limits
TOMTUBE_MAX_HEIGHT=1080
TOMTUBE_MAX_STREAMS=16
TOMTUBE_YTDLP_CONCURRENCY=3
TOMTUBE_YTDLP_TIMEOUT_MS=60000
TOMTUBE_CACHE_MAX_BYTES=2147483648
TOMTUBE_CACHE_MAX_AGE_HOURS=24
TOMTUBE_CACHE_MAX_FILE_BYTES=314572800
TOMTUBE_CACHE_CONCURRENCY=2
