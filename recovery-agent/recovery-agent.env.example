TOMIFY_RECOVERY_HOST=127.0.0.1
TOMIFY_RECOVERY_PORT=8788
# Deployed Git short SHA shown in health/status and compared with the site's build version.
TOMIFY_VERSION=
TOMIFY_RECOVERY_DIR=/srv/music-recovery
TOMIFY_MASTER_DIR=/srv/music
TOMIFY_RECOVERY_TOKEN=replace-with-a-long-random-secret
# Development only: permits no token when TOMIFY_RECOVERY_HOST is loopback. Never enable this in production.
TOMIFY_RECOVERY_ALLOW_INSECURE_LOOPBACK=false
# Lets Navidrome administrators restart the server from Tomify Settings. Also needs the polkit rule in docs/RECOVERY.md.
TOMIFY_RECOVERY_ALLOW_REBOOT=false
# Settings VPN status and connect/disconnect; the service account must be in the nordvpn group (docs/RECOVERY.md).
TOMIFY_RECOVERY_ALLOW_VPN_CONTROL=false
# TOMIFY_VPN_CONNECT_TARGET=United_Kingdom
TOMIFY_YOUTUBE_COOKIES=/opt/tomify/secrets/youtube.cookies
TOMIFY_ARCHIVE_MAX_BYTES=1073741824
TOMIFY_NEWZNAB_INDEXERS_JSON=[]
# Optional: NZBIndex works anonymously for normal use.
TOMIFY_NZBINDEX_API_KEY=
TOMIFY_SABNZBD_URL=
TOMIFY_SABNZBD_API_KEY=
# Optional: remove a successfully imported SABnzbd completion folder. Off by default.
TOMIFY_SABNZBD_CLEANUP=false
# Optional: SABnzbd's view of the completed root when it differs from the host path below (for example, /downloads in Docker).
TOMIFY_SABNZBD_DOWNLOAD_DIR=
# Use NZBGet instead of SABnzbd by setting TOMIFY_NZBGET_URL, TOMIFY_NZBGET_USERNAME and TOMIFY_NZBGET_PASSWORD.
TOMIFY_USENET_DOWNLOAD_DIR=/srv/usenet/completed
TOMIFY_USENET_CATEGORY=music
TOMIFY_USENET_MAX_BYTES=2147483648
# Fail a Usenet job after it has been absent from both downloader queue and history for this long.
TOMIFY_DOWNLOADER_LOST_MINUTES=15
TOMIFY_RECOVERY_STATE_DIR=/var/lib/tomify-recovery
# How often the agent advances queued downloads and imports on its own, in seconds.
TOMIFY_JOB_POLL_SECONDS=10
# Torrent links through qBittorrent-nox (see docs/RECOVERY.md "Torrent links and qBittorrent"). Leave the URL blank to turn off.
TOMIFY_QBITTORRENT_URL=
TOMIFY_QBITTORRENT_USERNAME=tomify
TOMIFY_QBITTORRENT_PASSWORD=
TOMIFY_TORRENT_DOWNLOAD_DIR=/srv/torrents
# Optional: qBittorrent's view of the download root when it differs from the host path above (for example, /downloads in Docker).
TOMIFY_QBITTORRENT_DOWNLOAD_DIR=
TOMIFY_TORRENT_CATEGORY=tomify
# Optional: Prowlarr or Jackett indexers searched alongside qBittorrent's search plugins (docs/RECOVERY.md "Prowlarr or Jackett").
# TOMIFY_TORRENT_INDEXERS_JSON='[{"type":"prowlarr","name":"Prowlarr","url":"http://127.0.0.1:9696","apiKey":"..."}]'
TOMIFY_TORRENT_INDEXERS_JSON=
TOMIFY_TORRENT_MAX_BYTES=4294967296
# Most files and folders one completed torrent may hold (default 10000).
# TOMIFY_TORRENT_MAX_FILES=10000
# How many torrents qBittorrent downloads at once (1-50). The agent sets qBittorrent's queue limits to match.
TOMIFY_TORRENT_MAX_ACTIVE=5
# Tomifin Downloader (/tomifin/; docs/TOMIFIN.md): films and TV through the same qBittorrent into Jellyfin's libraries.
# Off unless both are set. They must be separate from each other and from every folder above.
# TOMIFY_TOMIFIN_FAMILY_DIR=/media/family
# TOMIFY_TOMIFIN_PRIVATE_DIR=/media/private
# Only when qBittorrent sees the libraries at other paths (for example in Docker):
# TOMIFY_TOMIFIN_FAMILY_QBITTORRENT_DIR=
# TOMIFY_TOMIFIN_PRIVATE_QBITTORRENT_DIR=
# Largest torrent Tomifin will queue (default 200 GiB).
# TOMIFY_TOMIFIN_MAX_BYTES=214748364800
# 7-Zip unpacks zip, rar and 7z archives found in a torrent. Debian 12's 7zip package installs it as 7zz.
SEVEN_ZIP_PATH=/usr/bin/7z
YT_DLP_PATH=/usr/local/bin/yt-dlp
FFPROBE_PATH=/usr/bin/ffprobe
FFMPEG_PATH=/usr/bin/ffmpeg
# ReplayGain tags on imported tracks for loudness normalisation; blank turns tagging off. See docs/RECOVERY.md "ReplayGain tagging".
RSGAIN_PATH=
# BPM, genre and mood tags on imported tracks for the DJ; see docs/RECOVERY.md "BPM, genre and mood tags".
# BPM_PATH is bpm-tools' bpm (blank turns tempo off); STYLE_LOOKUP=on looks genre and mood up on MusicBrainz,
# and a free Last.fm API key adds Last.fm's tags, the main source of moods.
BPM_PATH=
STYLE_LOOKUP=
# LASTFM_API_KEY=
# Adaptive streaming (HLS) for the player; see docs/RECOVERY.md "Adaptive streaming (HLS)".
# TOMIFY_HLS_ENABLED=true
# Navidrome as the box reaches it locally.
# TOMIFY_NAVIDROME_URL=http://127.0.0.1:4533
TOMIFY_HLS_CACHE_DIR=/var/cache/tomify-recovery/hls
# TOMIFY_HLS_CACHE_MAX_BYTES=2147483648
# LAN-direct streaming: an HTTPS listener players on the home network stream from; see docs/DEPLOYMENT.md
# "LAN-direct streaming". Off unless the port, both certificate files and TOMIFY_MEDIA_KEY are set.
# TOMIFY_MEDIA_KEY must be the same value as the Worker's TOMIFY_MEDIA_KEY secret (32+ characters).
# TOMIFY_LAN_PORT=8789
# TOMIFY_LAN_HOST=0.0.0.0
# TOMIFY_LAN_TLS_CERT=/opt/tomify/secrets/lan/fullchain.pem
# TOMIFY_LAN_TLS_KEY=/opt/tomify/secrets/lan/privkey.pem
# TOMIFY_MEDIA_KEY=
# TOMIFY_LAN_ALLOWED_ORIGINS=https://app.tomify.tomdixon.uk
