[Unit]
Description=Tomify recovery agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tom
WorkingDirectory=/opt/tomify/recovery-agent
EnvironmentFile=/etc/tomify/recovery-agent.env
ExecStart=/usr/bin/node /opt/tomify/recovery-agent/index.mjs
Restart=on-failure
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/music-recovery /var/lib/tomify-recovery /var/cache/tomify-recovery -/opt/tomify/secrets/youtube.cookies
ReadOnlyPaths=/srv/usenet/completed
ReadOnlyPaths=-/srv/torrents
ReadOnlyPaths=/opt/tomify/secrets

[Install]
WantedBy=multi-user.target
