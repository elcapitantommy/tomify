# Catch-up run of the Tomifin Family importer: every finished Family torrent with no outcome yet (a hook that did not
# fire, or a torrent that was not ready the first time). Same sandbox as tomifin-family-import.service.
[Unit]
Description=Tomifin Family importer (catch-up scan)
After=qbittorrent-nox.service
ConditionPathIsDirectory=/media/family/.downloads

[Service]
Type=oneshot
User=qbittorrent
Group=qbittorrent
SupplementaryGroups=media-family
EnvironmentFile=/etc/tomify/recovery-agent.env
Environment=TOMIFIN_IMPORT_LIBRARY=/media/family
ExecStart=/usr/bin/node /opt/tomify/recovery-agent/family-import.mjs --scan
StateDirectory=tomifin-import
StateDirectoryMode=0700
UMask=0002
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ProtectHome=tmpfs
ReadWritePaths=/media/family
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
