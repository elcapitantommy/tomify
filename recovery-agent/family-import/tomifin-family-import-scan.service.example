# Catch-up run of the Tomifin Family importer: every finished Family torrent with no outcome yet (a hook that did not
# fire, or a torrent that was not ready the first time). Same sandbox as tomifin-family-import.service.
[Unit]
Description=Tomifin Family importer (catch-up scan)
After=qbittorrent-nox.service
ConditionPathIsDirectory=/media/family/.downloads

[Service]
Type=oneshot
User=qbittorrent
Group=qbittorrent
SupplementaryGroups=media-family
EnvironmentFile=/etc/tomify/recovery-agent.env
Environment=TOMIFIN_IMPORT_LIBRARY=/media/family
# Clean films go to /media/family/Movies/Title (Year)/, next to the ones already there.
Environment=TOMIFIN_IMPORT_MOVIES_SUBDIR=Movies
# Only the qBittorrent settings are needed: the agent's other secrets are dropped before the importer starts.
UnsetEnvironment=TOMIFY_RECOVERY_TOKEN TOMIFY_YOUTUBE_COOKIES TOMIFY_SABNZBD_API_KEY TOMIFY_LAN_TLS_KEY TOMIFY_MEDIA_KEY
ExecStart=/usr/bin/node /opt/tomify/current/recovery-agent/family-import.mjs --scan
StateDirectory=tomifin-import
StateDirectoryMode=0700
UMask=0002
Nice=10
IOSchedulingClass=idle
ProtectSystem=strict
ProtectHome=tmpfs
ReadWritePaths=/media/family
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
