# Tomifin Family importer: publishes finished Family torrents from /media/family/.downloads into the Jellyfin
# library as hardlinks (docs/TOMIFIN.md, "Family import"). Started by tomifin-family-import.path when qBittorrent's
# hook queues a torrent, and by tomifin-family-import.timer as a catch-up.
#
# It runs as qbittorrent because the kernel only lets a file's owner (or someone who may also write to it) hardlink
# it (fs.protected_hardlinks), and qBittorrent owns the downloaded files. Everything else is locked down: it can
# write only to the Family library and its own state folder, and reach only qBittorrent on this machine.
[Unit]
Description=Tomifin Family importer
After=qbittorrent-nox.service
ConditionPathIsDirectory=/media/family/.downloads

[Service]
Type=oneshot
User=qbittorrent
Group=qbittorrent
SupplementaryGroups=media-family
# The agent's settings, for TOMIFY_QBITTORRENT_URL and its login (not copied anywhere).
EnvironmentFile=/etc/tomify/recovery-agent.env
Environment=TOMIFIN_IMPORT_LIBRARY=/media/family
# Clean films go to /media/family/Movies/Title (Year)/, next to the ones already there.
Environment=TOMIFIN_IMPORT_MOVIES_SUBDIR=Movies
# TV episodes and season packs go to /media/family/TV/<Series>/Season NN/.
Environment=TOMIFIN_IMPORT_TV_SUBDIR=TV
# Only the qBittorrent settings are needed: the agent's other secrets are dropped before the importer starts.
UnsetEnvironment=TOMIFY_RECOVERY_TOKEN TOMIFY_YOUTUBE_COOKIES TOMIFY_SABNZBD_API_KEY TOMIFY_LAN_TLS_KEY TOMIFY_MEDIA_KEY
# The deployed agent release (the same code tomify-recovery.service runs).
ExecStart=/usr/bin/node /opt/tomify/current/recovery-agent/family-import.mjs --queue
StateDirectory=tomifin-import
StateDirectoryMode=0700
UMask=0002
Nice=10
IOSchedulingClass=idle

# /media/family is the host's fstab bind mount of /home/tom/jellyfin-server/media/family, so it stays visible while
# the rest of /home is hidden.
ProtectSystem=strict
ProtectHome=tmpfs
ReadWritePaths=/media/family
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# A call outside the filter fails with EPERM instead of killing node. Node 20's libuv tries io_uring, which
# @system-service leaves out; with EPERM it falls back to its thread pool. UV_USE_IO_URING=0 skips the attempt.
SystemCallErrorNumber=EPERM
Environment=UV_USE_IO_URING=0
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
